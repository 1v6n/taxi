<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="diagram-pcs-verification" name="10GBASE-R PCS Verification Architecture (Skew &amp; Bitslip)">
    <mxGraphModel dx="975" dy="625" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="830" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15;fontFamily=Helvetica;fontStyle=1;" value="10GBASE-R Verification Architecture: PCS Test Plan (Generador 1 + 2 &amp;amp; Checker 1 + 3)" vertex="1">
          <mxGeometry height="30" width="650" x="315" y="15" as="geometry" />
        </mxCell>
        <mxCell id="container_tx" parent="1" style="swimlane;startSize=26;horizontal=1;fontStyle=1;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;" value="TRANSMIT DATAPATH (TX)" vertex="1">
          <mxGeometry height="205" width="1200" x="40" y="55" as="geometry" />
        </mxCell>
        <mxCell id="gen_xgmii" parent="container_tx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;GENERADOR 1: XGMII TX&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;IEEE 802.3 Clause 46 Stimulus&lt;/div&gt;&lt;div style=&quot;margin-top: 8px; font-size: 9px; line-height: 1.45;&quot;&gt;• Drives xgmii_txd[63:0], xgmii_txc[7:0]&lt;br&gt;• Emits /S/ (Lane 0), /T/ &amp;amp; Idles&lt;br&gt;• Transmits PRBS payload&lt;br&gt;• Injects /E/ &amp;amp; corrupted lanes&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="250" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="dut_tx" parent="container_tx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;10GBASE-R PCS TRANSMIT DUT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;taxi_eth_phy_10g.sv [ DUT TX ]&lt;/div&gt;&lt;div style=&quot;margin-top: 10px; font-size: 9px; line-height: 1.5;&quot;&gt;• &lt;b&gt;64B/66B Encoder:&lt;/b&gt; Clause 49-7 block formats&lt;br&gt;• &lt;b&gt;Scrambler:&lt;/b&gt; G(x) = 1 + x&lt;sup&gt;39&lt;/sup&gt; + x&lt;sup&gt;58&lt;/sup&gt;&lt;br&gt;• Emits serdes_tx_data[63:0] &amp;amp; hdr[1:0]&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="440" x="380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="checker_pcs_tx" parent="container_tx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;CHECKER 1: PCS TX&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;IEEE 802.3 Clause 49 Verification&lt;/div&gt;&lt;div style=&quot;margin-top: 8px; font-size: 9px; line-height: 1.45;&quot;&gt;• Monitors serdes_tx_data[63:0] &amp;amp; hdr[1:0]&lt;br&gt;• Validates sync headers (01b / 10b)&lt;br&gt;• Verifies 64B/66B block formatting&lt;br&gt;• PRBS check with local descrambler &amp;amp; lock&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="250" x="930" y="40" as="geometry" />
        </mxCell>
        <mxCell id="container_rx" parent="1" style="swimlane;startSize=26;horizontal=1;fontStyle=1;collapsible=0;rounded=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;" value="SERDES CHANNEL &amp;amp; RECEIVE DATAPATH (RX)" vertex="1">
          <mxGeometry height="520" width="1200" x="40" y="280" as="geometry" />
        </mxCell>
        <mxCell id="gen_serdes_skew" parent="container_rx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 11.5px;&quot;&gt;&lt;b&gt;GENERADOR 2: PCS &amp;amp; SKEW&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;IEEE 802.3 Clause 49 Impairment &amp;amp; Stimulus&lt;/div&gt;&lt;div style=&quot;margin-top: 6px; font-size: 8.5px; line-height: 1.4;&quot;&gt;• Injects 0 to 65 bits of skew&lt;br&gt;• Corrupts sync headers (00b / 11b)&lt;br&gt;• Injects reserved block types &amp;amp; illegal control&lt;br&gt;• Sets skew offset for SerDes PMA Channel&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="250" x="930" y="35" as="geometry" />
        </mxCell>
        <mxCell id="serdes_pma" parent="container_rx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;SERDES PMA CHANNEL&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;Physical Loopback &amp;amp; Barrel Shifter&lt;/div&gt;&lt;div style=&quot;margin-top: 8px; font-size: 9px; line-height: 1.45;&quot;&gt;• Loops back TX data to PCS RX&lt;br&gt;• 66-bit barrel shifter with skew offset&lt;br&gt;• Shifts 1 bit per serdes_rx_bitslip pulse&lt;br&gt;• Drives serdes_rx_data[63:0] &amp;amp; hdr[1:0]&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="250" x="930" y="165" as="geometry" />
        </mxCell>
        <mxCell id="dut_rx" parent="container_rx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12.5px;&quot;&gt;&lt;b&gt;10GBASE-R PCS RECEIVE DUT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;taxi_eth_phy_10g.sv [ DUT RX ]&lt;/div&gt;&lt;div style=&quot;margin-top: 10px; font-size: 9px; line-height: 1.5;&quot;&gt;• &lt;b&gt;Block Lock FSM:&lt;/b&gt; Figure 49-14 sync &amp;amp; bitslip logic&lt;br&gt;• &lt;b&gt;Descrambler:&lt;/b&gt; G(x) = 1 + x&lt;sup&gt;39&lt;/sup&gt; + x&lt;sup&gt;58&lt;/sup&gt;&lt;br&gt;• &lt;b&gt;64B/66B Decoder:&lt;/b&gt; with error marking (/E/)&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="440" x="380" y="165" as="geometry" />
        </mxCell>
        <mxCell id="checker_xgmii_rx" parent="container_rx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;CHECKER 2: XGMII RX&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;IEEE 802.3 Clause 46 Verification&lt;/div&gt;&lt;div style=&quot;margin-top: 8px; font-size: 9px; line-height: 1.45;&quot;&gt;• Monitors xgmii_rxd[63:0], xgmii_rxc[7:0]&lt;br&gt;• Validates /S/ (Lane 0) and /T/ delimiters&lt;br&gt;• Validates /E/ errors &amp;amp; lane order&lt;br&gt;• PRBS check with local lock &amp;amp; tracking&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="250" x="20" y="165" as="geometry" />
        </mxCell>
        <mxCell id="checker_pcs_rx" parent="container_rx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;CHECKER 3: PCS RX&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-top: 2px;&quot;&gt;IEEE 802.3 Clause 49 Verification&lt;/div&gt;&lt;div style=&quot;margin-top: 8px; font-size: 9px; line-height: 1.45;&quot;&gt;• Monitors Block Lock FSM (Figure 49-14)&lt;br&gt;• Verifies serdes_rx_bitslip high/low pulse timing&lt;br&gt;• Measures lock time to rx_block_lock = 1&lt;br&gt;• Tracks rx_bad_block, rx_error_count &amp;amp; rx_status&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="440" x="380" y="350" as="geometry" />
        </mxCell>
        <mxCell id="wire_gen_dut" edge="1" parent="1" source="gen_xgmii" target="dut_tx" value="&lt;b&gt;xgmii_txd[63:0]&lt;/b&gt; (/64)&lt;br&gt;&lt;b&gt;xgmii_txc[7:0]&lt;/b&gt; (/8)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_dut_chk1" edge="1" parent="1" source="dut_tx" target="checker_pcs_tx" value="&lt;b&gt;serdes_tx_data[63:0]&lt;/b&gt; (/64)&lt;br&gt;&lt;b&gt;serdes_tx_hdr[1:0]&lt;/b&gt; (/2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_loopback_drop" edge="1" parent="1" source="checker_pcs_tx" target="gen_serdes_skew" value="&lt;b&gt;SerDes TX Stream&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_skew_to_pma" edge="1" parent="1" source="gen_serdes_skew" target="serdes_pma" value="&lt;b&gt;Skewed Stream (0-65b)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_pma_dut" edge="1" parent="1" source="serdes_pma" target="dut_rx" value="&lt;b&gt;serdes_rx_data[63:0]&lt;/b&gt; (Skewed)&lt;br&gt;&lt;b&gt;serdes_rx_hdr[1:0]&lt;/b&gt; (/2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_bitslip_fb" edge="1" parent="1" source="dut_rx" target="serdes_pma" value="&lt;b&gt;serdes_rx_bitslip&lt;/b&gt; (Feedback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_dut_chk2" edge="1" parent="1" source="dut_rx" target="checker_xgmii_rx" value="&lt;b&gt;xgmii_rxd[63:0]&lt;/b&gt; (/64)&lt;br&gt;&lt;b&gt;xgmii_rxc[7:0]&lt;/b&gt; (/8)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wire_dut_chk3" edge="1" parent="1" source="dut_rx" target="checker_pcs_rx" value="&lt;b&gt;PCS RX FSM &amp;amp; Status:&lt;/b&gt; rx_block_lock, serdes_rx_bitslip, rx_status, rx_bad_block, rx_error_count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.8;endArrow=classic;endFill=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#000000;fontColor=#000000;fontSize=8.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>